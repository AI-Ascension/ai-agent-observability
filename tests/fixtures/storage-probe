#!/usr/bin/env bash
set -euo pipefail
command_name=${0##*/}
path=${!#}
fault=${FAULT:-healthy}
case "$command_name" in
  realpath)
    if [[ "$fault" == symlink && "$path" == /srv/data ]]; then echo /srv/other; else echo "$path"; fi
    ;;
  stat)
    if [[ "$path" == "$TEST_MANIFEST" ]]; then exec /usr/bin/stat "$@"; fi
    case "$2" in
      %F) echo 'block special file' ;;
      %d)
        case "$path" in
          /) echo 10 ;;
          /srv/data) if [[ "$fault" == root_alias ]]; then echo 10; else echo 11; fi ;;
          /srv/logs) if [[ "$fault" == shared_fs ]]; then echo 11; else echo 12; fi ;;
          *) exit 1 ;;
        esac ;;
      *) exit 1 ;;
    esac
    ;;
  lsblk)
    if [[ "$fault" == thin ]]; then printf '%s thin\n/dev/sda disk\n' "$path"
    elif [[ "$fault" == loop ]]; then printf '%s loop\n' "$path"
    else printf '%s part\n/dev/sda disk\n' "$path"; fi
    ;;
  findmnt)
    target='' field=''
    while (( $# )); do
      case "$1" in --mountpoint) target=$2; shift ;; --output) field=$2; shift ;; esac
      shift
    done
    [[ "$fault" != missing || "$target" != /srv/data ]] || exit 1
    case "$target" in
      /) dev=/dev/vda1; uuid=aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa ;;
      /srv/data) dev=/dev/sda1; uuid=11111111-1111-1111-1111-111111111111 ;;
      /srv/logs) dev=/dev/sda2; uuid=22222222-2222-2222-2222-222222222222 ;;
      *) exit 1 ;;
    esac
    case "$field" in
      TARGET) echo "$target" ;;
      SOURCE) if [[ "$fault" == replaced && "$target" == /srv/data ]]; then echo /dev/sdb1; else echo "$dev"; fi ;;
      UUID) if [[ "$fault" == wrong_uuid && "$target" == /srv/data ]]; then echo bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb; else echo "$uuid"; fi ;;
      FSTYPE) echo ext4 ;;
      OPTIONS) if [[ "$fault" == read_only && "$target" == /srv/data ]]; then echo ro,relatime; else echo rw,relatime; fi ;;
      *) exit 1 ;;
    esac
    ;;
  df)
    total=1000000; available=800000
    if [[ " $* " == *' -i '* ]]; then
      total=1000; available=800
      [[ "$fault" != inodes ]] || available=1
    else
      [[ "$fault" != full ]] || available=1
      [[ "$fault" != negative ]] || available=-1
      [[ "$fault" != ceiling ]] || total=2000000
      [[ "$fault" != overflow ]] || total=999999999999999999999999999
    fi
    printf 'Filesystem total used available percent mount\n/dev/sda1 %s 0 %s 20%% %s\n' "$total" "$available" "$path"
    ;;
  *) exit 1 ;;
esac
