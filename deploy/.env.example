# This file is a schema/example only. Run ./init.sh to generate deploy/.env.
# Never commit deploy/.env or replace these values with real credentials here.

BIND_ADDRESS=127.0.0.1

MLFLOW_VERSION=v3.16.0
MLFLOW_PORT=15000
MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=replace-with-init-generated-secret
MLFLOW_POSTGRES_DB=mlflow
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://mlflow:replace-with-init-generated-secret@mlflow-postgres:5432/mlflow
MLFLOW_S3_BUCKET=mlflow
MLFLOW_EXPERIMENT_ID=0
RUSTFS_API_PORT=19000
RUSTFS_CONSOLE_PORT=19001
RUSTFS_CONSOLE_ENABLE=true

AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-init-generated-access-key
AWS_SECRET_ACCESS_KEY=replace-with-init-generated-secret

LAMINAR_VERSION=v0.2.3
LAMINAR_HTTP_PORT=18000
LAMINAR_GRPC_PORT=18001
LAMINAR_REALTIME_PORT=18002
LAMINAR_FRONTEND_PORT=15667
LAMINAR_PUBLIC_URL=http://127.0.0.1:15667
POSTGRES_USER=laminar
POSTGRES_PASSWORD=replace-with-init-generated-secret
POSTGRES_DB=laminar
RABBITMQ_DEFAULT_USER=laminar
RABBITMQ_DEFAULT_PASS=replace-with-init-generated-secret
CLICKHOUSE_USER=lmnr
CLICKHOUSE_PASSWORD=replace-with-init-generated-secret
CLICKHOUSE_RO_USER=lmnr
CLICKHOUSE_RO_PASSWORD=replace-with-init-generated-secret
SHARED_SECRET_TOKEN=replace-with-init-generated-secret
AEAD_SECRET_KEY=replace-with-init-generated-64-hex-key
SLACK_ENCRYPTION_KEY=replace-with-init-generated-64-hex-key
LAMINAR_TELEMETRY_DISABLED=true
LAMINAR_PROJECT_API_KEY=replace-with-init-generated-64-character-key
LAMINAR_PROJECT_ID=00000000-0000-4000-8000-000000000001
LAMINAR_WORKSPACE_ID=00000000-0000-4000-8000-000000000002
LAMINAR_PROJECT_NAME=AI-Ascension Agent Research
LAMINAR_WORKSPACE_NAME=AI-Ascension Research
LAMINAR_ADMIN_EMAIL=admin@ai-agent-observability.local

QUICKWIT_HTTP_PORT=17280
QUICKWIT_OTLP_PORT=17281
OTEL_GRPC_PORT=14317
OTEL_HTTP_PORT=14318

# Optional Laminar AI-assistant configuration. Leave blank to keep outbound
# model calls disabled; set these only in the target's mode-0600 .env.
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_SMALL=
LLM_MODEL_MEDIUM=
LLM_MODEL_LARGE=
RUST_LOG=info
