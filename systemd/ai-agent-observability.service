[Unit]
Description=AI-Ascension AI-agent observability stack
Documentation=https://github.com/AI-Ascension/ai-agent-observability
Wants=network-online.target
After=network-online.target podman.socket
Requires=podman.socket

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/completetrain/ai-agent-observability/deploy
Environment=DOCKER_HOST=unix:///run/podman/podman.sock
ExecStart=/usr/bin/docker compose -p ai-agent-observability -f compose.yaml up -d --no-build
ExecStop=/usr/bin/docker compose -p ai-agent-observability -f compose.yaml down
TimeoutStartSec=0
TimeoutStopSec=300
KillMode=process

[Install]
WantedBy=multi-user.target
